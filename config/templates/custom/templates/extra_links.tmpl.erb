<a class="item" href="{{AppSubUrl}}/-/admin/actions/runners/1">{{svg "octicon-three-bars"}}</a>
<a class="item" id="navbar-home" href="{{AppSubUrl}}/main" aria-label="home"></a>
<a class="item" <%= 'style="display: none;"' unless @local %> href="{{AppSubUrl}}/main/config">{{svg "octicon-package"}}</a>

<div class="ui dropdown jump item"><%= @local ? "localhost" : "remote" %> {{svg "octicon-chevron-down" 14}}
  <div class="transition menu user-menu">
    <% (node.dig('git', 'org') || {}).values.compact.each do |org| %>
      <div class="item muted-links">
        {{if .IsSigned}}
          <a class="item" role="menuitem" href="{{AppSubUrl}}/org/<%= org %>/settings">{{svg "octicon-sliders"}} </a>
        {{end}}
        <a class="item" role="menuitem" href="{{AppSubUrl}}/<%= org %>"><%= org %></a>
      </div>
      <div class="divider"></div>
    <% end %>
  </div>
</div>
